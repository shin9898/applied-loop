{
  "name": "applied-loop",
  "version": "0.1.0",
  "private": true,
  "license": "FSL-1.1-MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "setup": "node scripts/bootstrap-local.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "audit:onboarding": "node scripts/audit-onboarding-sync.mjs",
    "preflight": "node scripts/preflight-local.mjs --ports",
    "mcp:cloud-config": "node scripts/print-cloud-mcp-config.mjs",
    "import:data": "tsx scripts/import.ts",
    "seed:exp1": "tsx scripts/seed-exp1.ts",
    "seed:tutorial": "tsx scripts/seed-tutorial.ts",
    "digest": "node scripts/weekly-digest.mjs",
    "weekly:textbook": "NODE_OPTIONS=--conditions=react-server tsx scripts/generate-weekly-textbook.ts",
    "dev:terminal": "node scripts/terminal-server.mjs",
    "dev:all": "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\" concurrently \"npm run dev -- -p 3100\" \"npm run dev:terminal\"",
    "regrade": "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\" tsx scripts/regrade-gate.ts",
    "requeue:gen": "PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\" tsx scripts/requeue-failed-gen.ts",
    "funnel:report": "node scripts/activation-funnel-report.mjs",
    "supply:health": "tsx scripts/supply-health-weekly.ts",
    "eval:gate-gen": "tsx scripts/eval-gate-gen.ts",
    "eval:grade-spot": "tsx scripts/eval-grade-spot.ts",
    "eval:overlap-guard": "tsx scripts/eval-overlap-guard.ts",
    "dismiss:report": "tsx scripts/dismiss-reasons-report.ts",
    "harness:audit-cache": "tsx scripts/audit-harness-cache.ts",
    "harness:collector:install": "node scripts/manage-harness-collector.mjs install",
    "harness:collector:status": "node scripts/manage-harness-collector.mjs status",
    "harness:collector:uninstall": "node scripts/manage-harness-collector.mjs uninstall",
    "harness:preview-cycle-evidence": "tsx scripts/preview-h-cycle-evidence.ts",
    "harness:plan-usage-backfill": "tsx scripts/plan-harness-usage-backfill.ts",
    "harness:evaluate-preview": "tsx src/lib/loop-jobs/harness-evaluation/h-eval-preview-main.ts",
    "harness:evaluate-report-preview": "tsx src/lib/loop-jobs/harness-evaluation/harness-evaluation-report-preview-main.ts",
    "harness:evaluate-source-preview": "tsx src/lib/loop-jobs/harness-evaluation/harness-evaluation-source-preview-main.ts",
    "harness:evaluate-window-preview": "tsx src/lib/loop-jobs/harness-evaluation/harness-evaluation-window-preview-main.ts",
    "loop:worker": "node src/lib/loop-jobs/worker.mjs",
    "rewrite-gates": "node scripts/rewrite-gates.mjs",
    "postinstall": "node scripts/postinstall-node-pty.mjs && prisma generate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@xterm/addon-fit": "^0.11.0",
    "better-sqlite3": "^13.0.2",
    "lucide-react": "^1.28.0",
    "mcp-handler": "^2.1.0",
    "next": "16.2.12",
    "node-pty": "^1.1.0",
    "page-flip": "^2.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "ws": "^8.21.1",
    "xterm": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
