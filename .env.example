# 必須: MCP / events / harness-runs / じゅもん WS の Bearer
# npm run setup が弱い／空のとき自動生成する
MCP_TOKEN=replace-with-a-long-random-string

# ローカル SQLite（プロジェクトルートの dev.db）
DATABASE_URL="file:./dev.db"

# MCP ツール面: core（仲間向け既定・しれん系のみ）| full（本人用の全ツール）
# 詳細: docs/adr/0019-core-loop-phases.md
MCP_SURFACE=core

# UI からじゅもん（Claude/Codex）を開くとき true。npm run dev:all と併用
ENABLE_TERMINAL=true

# 任意: git hook / collect / Cloud Agent 向けの公開ベース URL（既定 http://localhost:3100）
# Cloud から届けるときはトンネル URL を入れる（詳細: docs/cloud-mcp.md）
# APPLIED_LOOP_URL=http://localhost:3100
# 別名（APPLIED_LOOP_URL より優先）:
# MCP_PUBLIC_URL=https://xxxx.trycloudflare.com
