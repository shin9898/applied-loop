// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model LoopJob {
  id             String   @id
  kind           String
  dedupeKey      String   @unique
  payloadJson    String
  payloadHash    String
  status         String
  attempts       Int      @default(0)
  maxAttempts    Int
  availableAt    DateTime
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  lockedBy       String?
  leaseToken     String?
  lastError      String?
  createdAt      DateTime
  updatedAt      DateTime
  finishedAt     DateTime?

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
}

// 学び (pm-learn の kind: material 相当)
// kind: book / article / course / magazine / other / insight (会話由来の原子的な学び)
model Entry {
  id        String   @id @default(cuid())
  title     String
  source    String?
  kind      String
  note      String?
  domain    String? // 大分類 (例: "TypeScript / MCP")
  createdAt DateTime @default(now())

  applications Application[]
  experiments  Experiment[]
  captures     Capture[]
}

// 受信箱 (LLM 会話からの学び候補。朝の仕分けで accepted/ignored に)
// ignored も残すのは accept 率 (捕捉精度) を計測するため (ADR-0005)
model Capture {
  id              String    @id @default(cuid())
  title           String
  note            String?
  status          String    @default("pending") // pending / accepted / ignored / expired
  sourceTool      String // claude-code / cursor / codex / manual
  sourceContext   String?
  capturedAt      DateTime  @default(now())
  reviewedAt      DateTime?
  entryId         String?
  entry           Entry?    @relation(fields: [entryId], references: [id], onDelete: SetNull)
  dedupeKey       String?
  importanceScore Int? // 0-100。LLM トリアージ用 (ADR-0012)
  triageReason    String? // LLM のスコア根拠 (ADR-0012)
  overlapCheckJson String? // しれん重複ガードの判定ログ (ADR-0021)。OverlapCheckLog の JSON
  misconceptionId  String? // 人間が選んだ最終的な Misconception id (紐付け先 or 新規作成id。ADR-0021)
  misconception    Misconception? @relation(fields: [misconceptionId], references: [id], onDelete: SetNull)
}

// 当日タスク → 関連学び/誤解/ゲートのマッピング (ADR-0013 §1)
// タスク正典は Hermes/TODO。サーバーは LLM が保存した結果だけを持つ
model DailyTaskMap {
  id        String   @id @default(cuid())
  dateKey   String   @unique // "2026-08-03" (JST)
  mappings  String // JSON: [{task, related: [{type, id, reason}]}]
  createdAt DateTime @default(now())
}

// 適用記録 (pm-learn の kind: application 相当。格上げの核心)
model Application {
  id              String   @id @default(cuid())
  entryId         String
  entry           Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  appliedTo       String
  note            String
  decisionChanged String? // 変わった意思決定・採否・優先順位
  createdAt       DateTime @default(now())
}

// オプションの30日実験 (ハイブリッドの「実験化」側)
model Experiment {
  id            String    @id @default(cuid())
  entryId       String
  entry         Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  action        String // やること1つ
  successMetric String // 成功指標1つ
  startDate     DateTime
  endDate       DateTime
  status        String    @default("active") // active / completed / abandoned
  outcome       String?
  createdAt     DateTime  @default(now())

  checkIns CheckIn[]
}

model CheckIn {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  date         DateTime   @default(now())
  done         Boolean    @default(true)
  note         String?
  createdAt    DateTime   @default(now())

  @@unique([experimentId, date])
}

// LP の waitlist 登録
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// hook からの生イベント + 発火判定結果 (ADR-0006)
model DevEvent {
  id         String   @id @default(cuid())
  kind       String // commit
  repo       String
  repoPath   String? // ローカルのリポジトリ絶対パス (diff 取得用。ローカルのみ)
  ref        String
  summary    String?
  fired      Boolean  @default(false) // ゲート発火したか
  skipReason String? // dedupe / throttled / daily_cap / backlog / gen_failed
  diffSnapshot String? // 切り詰め済みdiff。ローカルのみ、クラウド同期から除外すること (ADR-0006 追記 2026-08-16)
  receivedAt DateTime @default(now())
  incorporatedAt DateTime? // 章（きょう／編纂／週のしょ）のいずれかに組み込まれた瞬間にセット
  gates      Gate[]

  @@unique([kind, repo, ref])
}

// 理解度ゲート (出題)。answer / gradeNote / rubricResult はローカルのみでクラウド同期から除外すること
model Gate {
  id               String         @id @default(cuid())
  eventId          String?
  event            DevEvent?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  misconceptionId  String?
  misconception    Misconception? @relation(fields: [misconceptionId], references: [id], onDelete: SetNull)
  kind             String         @default("initial") // initial / retry / sr_review / module (ADR-0016)
  question         String
  targetConcept    String?
  domain           String? // 大分類 (例: "TypeScript / MCP", "PdM / 設計")
  answer           String? // ローカルのみ。クラウド同期除外
  status           String         @default("pending")
  // pending / answered / grading / grading_failed / passed / failed /
  // self_graded_pass / self_graded_fail / dismissed / parked (ADR-0020 C1-2)
  gradeNote        String? // ローカルのみ。クラウド同期除外
  /** 悪問スキップ等の理由 (B5-4)。例: bad_question / duplicate / other / parked / too_many */
  dismissReason    String?
  resources        String? // JSON: [{kind, label, ref}] (ADR-0007)
  rubricCriteria   String? // JSON: ["観点1", ...] 出題生成時 (ADR-0007)
  rubricResult     String? // JSON: [{aspect, score, note}] 採点後。ローカルのみ (ADR-0007)
  contextSummary   String? // 「このコミットでやったこと」2-3行要約 (ADR-0011)
  answerMode       String? // "self" | "researched" | "in_session" | "assisted" (ADR-0007/0010/0015。NSM 判定には使わない)
  accessedResource Boolean        @default(false) // リソースクリック記録 (ADR-0007)
  nextReviewAt     DateTime? // retry/sr_review の出題予定
  createdAt        DateTime       @default(now())
  answeredAt       DateTime?
  gradedAt         DateTime?
  textbookCheckOrigin TextbookCheckGateOrigin?
}

// 誤解 (コード非依存の抽象概念のみ保存。Capture 受信箱経由でユーザー accept 後に確定)
model Misconception {
  id           String    @id @default(cuid())
  concept      String
  status       String    @default("open") // open / resolved / regressed
  rootCause    String? // knowledge / verification / premise (ADR-0011。分類不能は null)
  firstGateId  String?
  resolvedAt   DateTime?
  reviewCount  Int       @default(0)
  nextReviewAt DateTime?
  createdAt    DateTime  @default(now())
  gates        Gate[]
  captures     Capture[] // しれん重複ガードで紐付いた Capture (ADR-0021)
}

// 弱点パターン集計の週次キャッシュ (ADR-0011)
model WeaknessPatternCache {
  id          String   @id @default("default")
  resultJson  String // JSON: WeaknessReport
  gradedCount Int      @default(0)
  computedAt  DateTime @default(now())
}

// 目標 (ADR-0008)。進捗率は持たず、証跡の密度と週次定性評価で可視化する
model Goal {
  id           String       @id @default(cuid())
  title        String
  period       String // "2026-H2" など自由形式
  kdi          String? // 自由記述
  focusDomains String? // JSON: ["TypeScript / MCP", ...] (ADR-0010)
  status       String       @default("active") // active / archived
  createdAt    DateTime     @default(now())
  links        GoalLink[]
  reviews      GoalReview[]
}

// 目標への汎用紐付け (Entry / Gate / Application / Misconception)
model GoalLink {
  id         String   @id @default(cuid())
  goalId     String
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  targetType String // entry / gate / application / misconception
  targetId   String
  confidence String // manual / llm_suggested / llm_auto
  createdAt  DateTime @default(now())

  @@unique([goalId, targetType, targetId])
}

// 週次の定性評価 (進捗率は出さない)
model GoalReview {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  weekKey   String // "2026-W31" (JST 基準)
  comment   String
  createdAt DateTime @default(now())

  @@unique([goalId, weekKey])
}

// ハーネス観測 (ADR-0009)。1 セッション = 1 レコード。会話本文は保存しない
model HarnessRun {
  id          String    @id @default(cuid())
  harness     String // claude / codex
  sessionId   String
  model       String?
  repo        String?
  tools       String? // JSON: [{name, kind, calls}]
  tokensIn    Int       @default(0)
  tokensOut   Int       @default(0)
  cacheRead   Int       @default(0)
  cacheCreate Int       @default(0)
  thinking    Int       @default(0)
  turns       Int       @default(0)
  // Raw counters above remain immutable source telemetry. The nullable fields
  // below are a versioned, server-derived evidence projection (ADR-0025).
  inputTotalTokens          Int?
  inputUncachedTokens       Int?
  cacheReadTokens           Int?
  cacheWriteTokens          Int? // null = source did not expose cache-write telemetry
  usageSemanticsVersion     String?
  usageNormalizationStatus  String?
  usageNormalizationReason  String?
  collectorVersion          String?
  contextFingerprint        String? // sha256:<hex>; never prompt/conversation text
  startedAt   DateTime
  endedAt     DateTime?

  @@unique([harness, sessionId])
}

// 要件 (ADR-0014)。理解確認の単位。タスク管理にはしない (正典は Hermes)
model Requirement {
  id           String            @id @default(cuid())
  title        String
  why          String? // 目的・背景
  criteria     String? // 受入条件 (自由記述)
  status       String            @default("active") // active / understood / done / abandoned
  understoodAt DateTime? // status=understood になった時刻 (briefing 表示用)
  createdAt    DateTime          @default(now())
  links        RequirementLink[]
}

// 要件への紐付け。LLM 提案は suggested、承認後・手動は approved (ADR-0014 §3)
model RequirementLink {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  targetType    String // gate / entry
  targetId      String
  status        String      @default("suggested") // suggested / approved
  createdAt     DateTime    @default(now())

  @@unique([requirementId, targetType, targetId])
}

// 日次教科書 (ADR-0020)。材料は DevEvent 全量。本書は圧縮ビュー。
model DailyTextbook {
  id                 String                 @id @default(cuid())
  dateKey            String                 @unique // "2026-08-10" JST
  title              String
  lead               String?
  status             String                 @default("ready") // draft / ready
  materialCount      Int                    @default(0)
  chapterCount       Int                    @default(0)
  peakHour           Int? // 0-23 JST
  droppedMaterialIds String? // JSON string[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  chapters           DailyTextbookChapter[]
  checks             DailyTextbookCheck[]
}

model DailyTextbookChapter {
  id           String         @id @default(cuid())
  textbookId   String
  textbook     DailyTextbook  @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  index        Int // 1-based
  title        String
  oneLiner     String
  bodyPlain    String
  bodyDeep     String?
  diagramKind  String         @default("generic") // silent_gap / drift / prefix / generic
  evidenceJson String         @default("[]") // JSON EvidenceLink[]
  materialIds  String         @default("[]") // JSON string[]
  source       String         @default("auto") // "auto"（毎日自動生成）/ "compiled"（帯から編纂）
  checks       DailyTextbookCheck[]

  @@unique([textbookId, index])
}

// 日次確認問い。Mastery: clear / partial / stuck / parked
model DailyTextbookCheck {
  id          String                @id @default(cuid())
  textbookId  String
  textbook    DailyTextbook         @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     DailyTextbookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  index       Int
  question    String
  mastery     String? // clear / partial / stuck / parked
  answeredAt  DateTime?
  source      String                @default("auto") // "auto" / "compiled"

  @@unique([textbookId, index])
}

// よみもの帯・書庫の実体。日次生成であふれた材料をrepo単位で保存する
// （2026-08-16、5repo×8件キャップでの取りこぼし対応）
model MaterialBand {
  id                String   @id @default(cuid())
  dateKey           String   // 材料を受け取った日 (JST)
  repo              String
  materialIds       String   // JSON string[]（あふれた DevEvent.id 全量）
  digest            String   // 1行サマリ
  count             Int
  compiledChapterId String?  // 「編纂する」で章に昇格したらセット
  resolvedAt        DateTime? // あふれが1件も残らなくなった時刻。物理削除はしない（書庫が全期間検索できる設計を保つため）
  createdAt         DateTime @default(now())

  @@unique([dateKey, repo])
}

// 週のしょ (Phase 2)。直前に完了した週で incorporatedAt が null のままの
// DevEvent を再クラスタリングし、週次レビューという回収儀式を実装する。
model WeeklyTextbook {
  id            String   @id @default(cuid())
  weekKey       String   @unique // ISO週 "2026-W33"（JST基準、weekKeyJST()）
  title         String
  lead          String?
  status        String   @default("ready")
  materialCount Int      @default(0)
  chapterCount  Int      @default(0)
  createdAt     DateTime @default(now())
  chapters      WeeklyTextbookChapter[]
  checks        WeeklyTextbookCheck[]
}

model WeeklyTextbookChapter {
  id           String   @id @default(cuid())
  weeklyId     String
  weekly       WeeklyTextbook @relation(fields: [weeklyId], references: [id], onDelete: Cascade)
  index        Int
  title        String
  oneLiner     String
  bodyPlain    String
  bodyDeep     String?
  diagramKind  String   @default("generic")
  evidenceJson String   @default("[]")
  materialIds  String   @default("[]")
  checks       WeeklyTextbookCheck[]

  @@unique([weeklyId, index])
}

model WeeklyTextbookCheck {
  id         String   @id @default(cuid())
  weeklyId   String
  weekly     WeeklyTextbook @relation(fields: [weeklyId], references: [id], onDelete: Cascade)
  chapterId  String?
  chapter    WeeklyTextbookChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  index      Int
  question   String
  mastery    String?
  answeredAt DateTime?

  @@unique([weeklyId, index])
}

// Textbook Checkを本人が明示的にGateへ昇格したときのimmutableな由来。
// 日次自動再生成で元Check行が消えても、Gateの問題・rubric・採点referenceを失わない。
model TextbookCheckGateOrigin {
  id                  String   @id @default(cuid())
  gateId              String   @unique
  gate                Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  sourceKind          String   // daily / weekly
  textbookKey         String   // dateKey / weekKey
  source              String   // auto / compiled
  checkIndex          Int
  chapterIndex        Int?
  sourceRevisionHash  String   // v1 canonical source snapshot SHA-256
  questionHash        String   // Gate.question SHA-256
  referenceHash       String   // referenceJson SHA-256
  referenceJson       String   // bounded local JSON; user answer/diff全文/secretは含めない
  createdAt           DateTime @default(now())

  @@unique([sourceKind, textbookKey, source, checkIndex, sourceRevisionHash])
  @@index([sourceKind, textbookKey, source, checkIndex])
}
