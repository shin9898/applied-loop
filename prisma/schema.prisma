// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 学び (pm-learn の kind: material 相当)
model Entry {
  id        String   @id @default(cuid())
  title     String
  source    String?
  kind      String // book / article / course / magazine / other
  note      String?
  createdAt DateTime @default(now())

  applications Application[]
  experiments  Experiment[]
}

// 適用記録 (pm-learn の kind: application 相当。格上げの核心)
model Application {
  id              String   @id @default(cuid())
  entryId         String
  entry           Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  appliedTo       String
  note            String
  decisionChanged String? // 変わった意思決定・採否・優先順位
  createdAt       DateTime @default(now())
}

// オプションの30日実験 (ハイブリッドの「実験化」側)
model Experiment {
  id            String    @id @default(cuid())
  entryId       String
  entry         Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  action        String // やること1つ
  successMetric String // 成功指標1つ
  startDate     DateTime
  endDate       DateTime
  status        String    @default("active") // active / completed / abandoned
  outcome       String?
  createdAt     DateTime  @default(now())

  checkIns CheckIn[]
}

model CheckIn {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  date         DateTime   @default(now())
  done         Boolean    @default(true)
  note         String?
  createdAt    DateTime   @default(now())

  @@unique([experimentId, date])
}

// LP の waitlist 登録
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// sr-cards.json からの移行モデル (SM-2 簡易版スケジュール管理のみ)
model SrCard {
  id          String    @id
  topic       String
  question    String
  answer      String
  created     DateTime
  lastReview  DateTime?
  nextReview  DateTime
  interval    Int       @default(1)
  easeFactor  Float     @default(2.5)
  repetitions Int       @default(0)
  score       Int       @default(0)
}
