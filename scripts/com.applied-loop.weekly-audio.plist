<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied Loop 週次ナレーションの音声化 (毎週月曜 10:00、ADR-0014 §1)

  weekly-audio-auto.sh が AivisSpeech Engine を必要なら headless 起動し、
  weekly-audio.sh で最新の週次ナレーション原稿を音声化する。

  インストール手順:
    1. このファイルを編集し、YOUR_USER を実際のユーザ名に置換する
       (ProgramArguments のパスもリポジトリ実パスに合わせる)
    2. cp scripts/com.applied-loop.weekly-audio.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.applied-loop.weekly-audio.plist
    4. 動作確認: launchctl start com.applied-loop.weekly-audio
       ログ: /tmp/applied-loop-weekly-audio.{out,err}.log
    5. 停止: launchctl unload ~/Library/LaunchAgents/com.applied-loop.weekly-audio.plist

  前提:
    - AivisSpeech.app が /Applications にインストールされていること
    - 週次ナレーション原稿 (*-narration.md) が OBSIDIAN_DIGEST_DIR/weekly/
      (既定 docs/digest/weekly/) に生成済みであること
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.applied-loop.weekly-audio</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/YOUR_USER/tools/applied-loop/scripts/weekly-audio-auto.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/applied-loop-weekly-audio.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/applied-loop-weekly-audio.err.log</string>
  </dict>
</plist>
