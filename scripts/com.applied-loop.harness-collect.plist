<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied Loop ハーネス観測の定期収集 (1時間ごと)

  任意の prefix 介入比較: APPLIED_LOOP_CONTEXT_FINGERPRINT=sha256:<64hex> を
  harness-collect.sh の環境へ明示すると、その値を新規sessionのcohort identityに使う。
  未指定時は会話本文を読まず harness/model/repo からmetadata-derived hashを作る。

  インストール手順:
    1. このファイルを編集し、YOUR_USER を実際のユーザ名に置換する
       (ProgramArguments のパスもリポジトリ実パスに合わせる)
    2. cp scripts/com.applied-loop.harness-collect.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.applied-loop.harness-collect.plist
    4. 動作確認: launchctl start com.applied-loop.harness-collect
       ログ: scripts/harness-collect.log
    5. 停止: launchctl unload ~/Library/LaunchAgents/com.applied-loop.harness-collect.plist

  前提:
    - Applied Loop が APPLIED_LOOP_URL (既定 http://localhost:3100) で起動していること
    - リポジトリの .env に MCP_TOKEN があること (harness-collect.sh が読む)
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.applied-loop.harness-collect</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/YOUR_USER/tools/applied-loop/scripts/harness-collect.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/applied-loop-harness-collect.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/applied-loop-harness-collect.err.log</string>
  </dict>
</plist>
